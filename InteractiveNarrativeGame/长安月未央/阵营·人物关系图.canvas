		{"id":"a57e4c015460910c","type":"file","file":"InteractiveNarrativeGame/长安月未央/设计/9 极简人设速查表.md","x":1400,"y":790,"width":340,"height":110},
		{"id":"6277f3032ea62acf","type":"file","file":"InteractiveNarrativeGame/长安月未央/设计/1 主要人物列表.md","x":1400,"y":920,"width":340,"height":110},
		{"id":"f3687938e877291d","type":"text","text":"**段淑妃**\n将门虎女，武艺高强\n后期：战功复位","x":0,"y":845,"width":240,"height":120,"color":"4"},
		{"id":"503fd6a3de286e36","type":"text","text":"**慕容昭仪**\n前朝燕国宗室后裔，太后拉拢的暗棋\n后期：暗卫身份公开","x":370,"y":840,"width":240,"height":120,"color":"4"},
		{"id":"a3f5a4c6f12a5d8d","type":"text","text":"**陈景**\n皇帝贴身内侍，办事圆滑机变","x":-290,"y":855,"width":240,"height":120,"color":"4"},
		{"id":"a4156acc66998663","type":"text","text":"**皇帝（阿淮）**\n亲征后展现真实军事才能\n后期：完全掌权","x":-290,"y":543,"width":240,"height":135,"color":"4"},
		{"id":"872cbc614c3afad1","type":"text","text":"## 阵营演变简述\n\n**早期**（01章-选后完成前）：太后系主导，皇帝势单力薄靠疯癫人设自保，裴家中立观望，女主独立摸索自保之道。\n\n**中期**（选后完成后至亲征前）：皇帝阵营逐渐成形并反向操控博弈；裴家（裴尚书死谏后）倒向皇帝；皇后阵营归属反复摇摆；女主深度介入皇帝阵营，但对外身份仍是小掌记。\n\n**后期**（亲征起至结局，本图所示）：太后系急剧萎缩瓦解；皇帝阵营成熟稳固；裴家受制衡但保留体面；皇后主动退出权力棋局；女主身份彻底公开。","x":-1100,"y":448,"width":540,"height":460,"color":"6"},
		{"id":"9fd9ef9c029c40a5","type":"text","text":"# 长安月未央 · 阵营与人物关系图\n\n基于 [[10 阵营 势力关系图]] 与 [[9 极简人设速查表]] 整理，展示**后期（亲征起至结局，约第四至第五年）**的阵营格局。\n完整的三个时间切片（早期 / 中期 / 后期）演变请见左下方说明卡片，或直接查看原始设计文档。","x":-350,"y":-640,"width":1180,"height":180},
		{"id":"f77cd5900e246894","type":"text","text":"**太后**\n罪奴出身、掖庭爬到今日，非皇帝生母\n后期：孤立无援","x":-920,"y":-230,"width":240,"height":120,"color":"1"},
		{"id":"73a9390b04bf1c61","type":"text","text":"**王贵人**\n选秀新入的最后一枚棋子\n后期：被禁足","x":-1160,"y":55,"width":240,"height":120,"color":"1"},
		{"id":"d6682b94e3eca190","type":"text","text":"**鲁承恩**\n军中内应\n后期：已伏诛（斩首示众）","x":-680,"y":55,"width":240,"height":120,"color":"1"},
		{"id":"d48d4508c7b3c1ee","type":"text","text":"**裴尚书**（已故）\n三朝老臣，以死谏为裴家换取政治资本","x":910,"y":-350,"width":240,"height":120,"color":"2"},
		{"id":"3b23372e66939669","type":"text","text":"**裴德妃**\n裴尚书孙女，代掌六宫\n后期：功高但被有意压制补缺规模","x":610,"y":-110,"width":240,"height":120,"color":"2"},
		{"id":"79a15764a8454f08","type":"text","text":"**裴颜卿**\n裴德妃兄长，军部左侍郎\n后期：军部实职，受制衡","x":1240,"y":-110,"width":240,"height":120,"color":"2"},
		{"id":"5aa9115135f51dec","type":"text","text":"**女主（李长安）**\n掌记/典记，善制图理账\n后期：身份彻底公开，参与亲征","x":370,"y":650,"width":240,"height":120,"color":"4"},
		{"id":"7e97d77f69e2d1b1","type":"text","text":"**韩崇**\n御林军统领→边军六镇守将\n后期：晋六镇守将","x":370,"y":491,"width":240,"height":120,"color":"4"}
	],
